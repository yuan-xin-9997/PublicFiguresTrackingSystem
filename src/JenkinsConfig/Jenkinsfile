pipeline {
    agent any
    options { timestamps(); disableConcurrentBuilds() }
    triggers { pollSCM('H/30 * * * *') }
    environment {
        APP_NAME = 'PublicFiguresTrackingSystem'
        DEPLOY_DIR = '/opt/PublicFiguresTrackingSystem'
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Backend test') {
            steps {
                dir('src') {
                    sh '''
                        python3 -m json.tool config/app.json >/dev/null
                        python3 -m venv .ci-venv
                        .ci-venv/bin/python -m pip install -r requirements.txt
                        PYTHONPATH=. .ci-venv/bin/python -m pytest -q
                    '''
                }
            }
        }
        stage('Frontend test and build') {
            steps {
                dir('src/app/frontend') {
                    sh 'npm ci && npm test && npm run build'
                }
            }
        }
        stage('OpenSpec validation') {
            steps {
                sh 'npx --yes @fission-ai/openspec@1.6.0 validate --all --strict'
            }
        }
        stage('Prepare release and backup') {
            steps {
                sh '''
                    python3 -m venv .release-venv
                    .release-venv/bin/python -m pip install -r src/requirements.txt
                    .release-venv/bin/python -m pip check
                    if [ -d "$DEPLOY_DIR/app" ]; then
                        BACKUP="$DEPLOY_DIR/data/backups/$(date +%Y/%m/%d)/build-$BUILD_NUMBER"
                        mkdir -p "$BACKUP"
                        tar -czf "$BACKUP/code.tar.gz" -C "$DEPLOY_DIR" app requirements.txt JenkinsConfig start.sh stop.sh status.sh
                        cp "$DEPLOY_DIR/config/app.json" "$BACKUP/app.json"
                        printf '%s' "$BACKUP" > .backup-path
                    fi
                '''
            }
        }
        stage('Stop current service') {
            steps {
                sh '''
                    if systemctl cat pfts.service >/dev/null 2>&1; then
                        sudo -n /usr/bin/systemctl stop pfts.service
                    elif [ -x "$DEPLOY_DIR/stop.sh" ]; then "$DEPLOY_DIR/stop.sh"; fi
                    if [ -f .backup-path ]; then
                        .release-venv/bin/python src/JenkinsConfig/backup_database.py "$DEPLOY_DIR/data/app.sqlite3" "$(cat .backup-path)/app.sqlite3"
                    fi
                '''
            }
        }
        stage('Update deployment') {
            steps {
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    rsync -a --delete --exclude data --exclude logs --exclude config/app.json --exclude .venv --exclude .ci-venv --exclude .pytest_cache --exclude app/frontend/node_modules src/ "$DEPLOY_DIR/"
                    rsync -a --delete .release-venv/ "$DEPLOY_DIR/.venv/"
                    mkdir -p "$DEPLOY_DIR/config" "$DEPLOY_DIR/data" "$DEPLOY_DIR/logs"
                    if [ ! -f "$DEPLOY_DIR/config/app.json" ]; then cp src/config/app.json "$DEPLOY_DIR/config/app.json"; fi
                    if [ ! -f "$DEPLOY_DIR/data/password.txt" ]; then cp src/data/password.txt "$DEPLOY_DIR/data/password.txt"; fi
                    chmod +x "$DEPLOY_DIR"/*.sh
                '''
            }
        }
        stage('Start and smoke test') {
            steps {
                sh '''
                    if systemctl cat pfts.service >/dev/null 2>&1; then
                        sudo -n /usr/bin/systemctl start pfts.service
                    else
                        JENKINS_NODE_COOKIE=dontKillMe "$DEPLOY_DIR/start.sh"
                    fi
                    sleep 3
                    if systemctl cat pfts.service >/dev/null 2>&1; then systemctl is-active pfts.service; else "$DEPLOY_DIR/status.sh"; fi
                    curl -fsS http://127.0.0.1:28000/api/v1/health/ready
                    set +x
                    SMOKE_USER=$(awk -F: '$3 == "admin" { print $1; exit }' "$DEPLOY_DIR/data/password.txt")
                    SMOKE_PASSWORD=$(awk -F: '$3 == "admin" { print $2; exit }' "$DEPLOY_DIR/data/password.txt")
                    test -n "$SMOKE_USER"
                    test -n "$SMOKE_PASSWORD"
                    PFTS_SMOKE_USER="$SMOKE_USER" PFTS_SMOKE_PASSWORD="$SMOKE_PASSWORD" \
                        "$DEPLOY_DIR/.venv/bin/python" "$DEPLOY_DIR/tests/smoke_live.py"
                    PFTS_SMOKE_SCAN_LOCAL=1 PFTS_SMOKE_USER="$SMOKE_USER" PFTS_SMOKE_PASSWORD="$SMOKE_PASSWORD" \
                        "$DEPLOY_DIR/.venv/bin/python" "$DEPLOY_DIR/tests/smoke_ai_live.py"
                    unset SMOKE_USER SMOKE_PASSWORD
                    set -x
                '''
            }
        }
    }
    post {
        failure { sh 'if systemctl cat pfts.service >/dev/null 2>&1; then systemctl status pfts.service --no-pager || true; elif [ -f "$DEPLOY_DIR/logs/server.stderr.log" ]; then tail -n 100 "$DEPLOY_DIR/logs/server.stderr.log"; fi' }
    }
}
